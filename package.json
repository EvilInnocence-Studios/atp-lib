{
  "name": "@atp/monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:geometry": "yarn workspace atp-geometry build",
    "build:poser": "yarn workspace atp-poser build",
    "build": "node scripts/build-and-deploy.mjs --clean --build",
    "test:geometry": "yarn workspace atp-geometry test",
    "test:poser": "yarn workspace atp-poser test",
    "test": "node scripts/build-and-deploy.mjs --no-build --test",
    "test:coverage:geometry": "yarn workspace atp-geometry test:coverage",
    "test:coverage:poser": "yarn workspace atp-poser test:coverage",
    "test:coverage": "yarn test:coverage:geometry && yarn test:coverage:poser",
    "deploy": "node scripts/build-and-deploy.mjs --clean --test --build --pack",
    "deploy:geometry": "node scripts/build-and-deploy.mjs --package geometry --clean --test --build --pack",
    "deploy:poser": "node scripts/build-and-deploy.mjs --package poser --clean --test --build --pack",
    "deploy:pack": "node scripts/build-and-deploy.mjs --clean --test --build --pack",
    "deploy:link": "node scripts/build-and-deploy.mjs --clean --test --build --link",
    "deploy:publish": "node scripts/build-and-deploy.mjs --clean --test --build --publish"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@vitest/coverage-v8": "1.6.1",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0"
  }
}
